# Template for the .env file (used by cron_upload.sh and cron_update.sh)
#
# Copy this file to the repository root as '.env' and fill in your values:
#   cp templates/.env.example .env
#
# The .env file is git-ignored — never commit real credentials.

# FTP/SFTP host for uploading the status page (cron_upload.sh)
HOST='ftp.example.com'

# Username for the FTP/SFTP account (cron_upload.sh)
USER='your-username'

# Password for the FTP/SFTP account (cron_upload.sh)
PASSWD='your-password'

# Healthchecks.io UUID for the dead man's switch (cron_update.sh).
# Leave unset or empty to skip the ping silently.
# Create an integrations check at https://healthchecks.io to get a UUID.
HEALTHCHECK_UUID=''
